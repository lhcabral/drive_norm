DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Use sqlite by default; set USE_POSTGRES=True to use docker-compose db
USE_POSTGRES=False
POSTGRES_DB=drive_norm
POSTGRES_USER=drive_norm
POSTGRES_PASSWORD=drive_norm
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

REDIS_URL=redis://127.0.0.1:6379/0
CHANNEL_LAYER_BACKEND=inmemory

# Mercado Pago. Prefira cadastrar o token no painel do admin (aba "PIX e pagamentos");
# este valor só é usado se o painel estiver vazio. Sem token: PIX simulado com DEBUG, desativado sem DEBUG.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://127.0.0.1:8000

# E-mail para recuperação de senha. Sem EMAIL_HOST, os e-mails aparecem no terminal do backend.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Drive Norm <nao-responda@seudominio.com>

LOW_BALANCE_THRESHOLD=20.00
PROPOSAL_TIMEOUT_SECONDS=120
