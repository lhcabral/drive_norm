# Copie para /drive/.env no servidor e troque todos os valores TROCAR_*.
#   Chave do Django:  python3 -c "import secrets; print(secrets.token_urlsafe(50))"
#   Senha do banco:   openssl rand -hex 24

DJANGO_SECRET_KEY=TROCAR_CHAVE_SECRETA
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=app.drivenorm.com.br,drivenorm.com.br,www.drivenorm.com.br,127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=https://app.drivenorm.com.br,https://drivenorm.com.br,https://www.drivenorm.com.br
CSRF_TRUSTED_ORIGINS=https://app.drivenorm.com.br,https://drivenorm.com.br,https://www.drivenorm.com.br

USE_POSTGRES=True
POSTGRES_DB=drive_norm
POSTGRES_USER=drive_norm
POSTGRES_PASSWORD=TROCAR_SENHA_DO_BANCO
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

REDIS_URL=redis://127.0.0.1:6379/0
CHANNEL_LAYER_BACKEND=redis

# Prefira cadastrar o token no painel do admin (aba "PIX e pagamentos").
# Sem token e com DEBUG=False, o PIX fica desativado.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
FRONTEND_URL=https://app.drivenorm.com.br
BACKEND_URL=https://app.drivenorm.com.br

# E-mail para recuperação de senha (ex.: Brevo, SendGrid, Gmail com senha de app).
# Sem EMAIL_HOST, os e-mails só aparecem no log: journalctl -u drivenorm-daphne
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Drive Norm <nao-responda@drivenorm.com.br>

LOW_BALANCE_THRESHOLD=20.00
PROPOSAL_TIMEOUT_SECONDS=120
