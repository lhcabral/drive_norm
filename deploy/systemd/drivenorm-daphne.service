[Unit]
Description=Drive Norm - Daphne (Django ASGI + WebSocket)
After=network.target postgresql.service redis-server.service
Requires=postgresql.service redis-server.service

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/drive/backend
ExecStart=/drive/venv/bin/daphne -b 127.0.0.1 -p 8000 --proxy-headers drive_norm.asgi:application
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
